# Assessment-only deployment. Replace every placeholder before publishing.
APP_ENV=production
PORT=8000
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ADMIN_USERNAME=assessor
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
DB_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
DB_POOL_MAX=4
